# OrthoTwin AI Environment Configuration
# Copy this file to .env and adjust as necessary

# Security
SECRET_KEY=change_me_to_a_secure_random_string_in_production
ALGORITHM=PBKDF2_SHA256
HASH_ITERATIONS=100000

# Database
DATABASE_URL=sqlite:///orthotwin.db

# Storage Directories (Relative to project root or absolute paths)
STORAGE_RAW_DIR=storage/uploads/raw
STORAGE_PROCESSED_DIR=storage/uploads/processed
STORAGE_REPORTS_DIR=storage/reports

# Image Quality Thresholds (Configurable)
MIN_IMAGE_DIMENSION=256
MAX_FILE_SIZE_MB=15
BLUR_THRESHOLD=100.0
LOW_CONTRAST_THRESHOLD=25.0

# Detection & Model Configuration
MODEL_WEIGHTS_PATH=models/weights/fracture_yolov8.pt
DETECTION_CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Prototype Safety & Institution Banner
INSTITUTION_NAME=OrthoTwin AI Research Laboratory
ENVIRONMENT=development
DISCLAIMER_TEXT=ACADEMIC PROTOTYPE ONLY - NOT A CLINICAL DIAGNOSTIC DEVICE
